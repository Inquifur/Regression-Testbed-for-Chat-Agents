{
  "schema_version": 1,
  "id": "qqagent_quote_priority",
  "description": "依据 ContextBuffer.conversation 显式引用分支；关闭主动接话，观察应用实际返回的 ConversationHint，非模型语义判断。",
  "bot_config": {
    "bot_id": "bot",
    "cooldown_ms": 3000,
    "window_ms": 60000,
    "max_messages_per_window": 100,
    "context_ttl_ms": 180000
  },
  "events": [
    {
      "id": "a",
      "type": "message",
      "at_ms": 0,
      "group_id": "g1",
      "user_id": "u1",
      "text": "Rust 编译工具链配置讨论",
      "mentions": []
    },
    {
      "id": "b",
      "type": "message",
      "at_ms": 0,
      "group_id": "g1",
      "user_id": "u2",
      "text": "周末公园散步安排",
      "mentions": []
    },
    {
      "id": "quote",
      "type": "message",
      "at_ms": 0,
      "group_id": "g1",
      "user_id": "u3",
      "text": "这个方案还需要什么材料",
      "mentions": [],
      "reply_to": "a"
    }
  ],
  "checks": [
    {
      "id": "explicit_quote",
      "after_event": "quote",
      "type": "conversation_field_equals",
      "event_id": "quote",
      "field": "evidence",
      "expected": "explicit_quote"
    },
    {
      "id": "quote_routes_to_a",
      "after_event": "quote",
      "type": "conversation_context_contains",
      "event_id": "quote",
      "message_id": "a"
    },
    {
      "id": "recent_b_not_selected",
      "after_event": "quote",
      "type": "conversation_context_excludes",
      "event_id": "quote",
      "message_id": "b"
    },
    {
      "id": "no_policy_model",
      "after_event": "quote",
      "type": "output_count",
      "event_id": "quote",
      "group_id": "g1",
      "expected": 0
    }
  ]
}
