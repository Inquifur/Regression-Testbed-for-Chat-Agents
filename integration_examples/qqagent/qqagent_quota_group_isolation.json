{
  "schema_version": 1,
  "id": "qqagent_quota_group_isolation",
  "description": "依据 RateLimiter._groups；A群预算耗尽后B群仍能回应；同一合成用户，模型输入的结构化会话ID也不跨群。",
  "bot_config": {
    "bot_id": "bot",
    "cooldown_ms": 3000,
    "window_ms": 60000,
    "max_messages_per_window": 1,
    "context_ttl_ms": 180000
  },
  "events": [
    {
      "id": "a",
      "type": "message",
      "at_ms": 0,
      "group_id": "g1",
      "user_id": "u1",
      "text": "你好",
      "mentions": [
        "bot"
      ]
    },
    {
      "id": "a_blocked",
      "type": "message",
      "at_ms": 3000,
      "group_id": "g1",
      "user_id": "u1",
      "text": "你好",
      "mentions": [
        "bot"
      ]
    },
    {
      "id": "b",
      "type": "message",
      "at_ms": 3000,
      "group_id": "g2",
      "user_id": "u1",
      "text": "你好",
      "mentions": [
        "bot"
      ]
    }
  ],
  "checks": [
    {
      "id": "first_consumes_a",
      "after_event": "a",
      "type": "output_count",
      "event_id": "a",
      "group_id": "g1",
      "expected": 1
    },
    {
      "id": "a_exhausted",
      "after_event": "a_blocked",
      "type": "decision_field_equals",
      "event_id": "a_blocked",
      "field": "reason",
      "expected": "reply_rate_limit"
    },
    {
      "id": "b_independent",
      "after_event": "b",
      "type": "output_count",
      "event_id": "b",
      "group_id": "g2",
      "expected": 1
    },
    {
      "id": "model_has_b",
      "after_event": "b",
      "type": "model_context_contains",
      "event_id": "b",
      "message_id": "b"
    },
    {
      "id": "model_excludes_a",
      "after_event": "b",
      "type": "model_context_excludes",
      "event_id": "b",
      "message_id": "a"
    }
  ]
}
