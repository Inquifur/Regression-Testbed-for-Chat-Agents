{
  "schema_version": 1,
  "id": "deliberate_failure",
  "description": "测试专用：故意把 1 条输出的期望写为 0，验证失败报告与退出码。",
  "bot_config": {
    "bot_id": "bot",
    "cooldown_ms": 0,
    "window_ms": 100,
    "max_messages_per_window": 10,
    "context_ttl_ms": 1000
  },
  "events": [
    {"id": "m1", "type": "message", "at_ms": 0, "group_id": "g1", "user_id": "u1", "text": "测试失败", "mentions": ["bot"]}
  ],
  "checks": [
    {"id": "wrong_count", "after_event": "m1", "type": "output_count", "event_id": "m1", "group_id": "g1", "expected": 0},
    {"id": "continues_after_failure", "after_event": "m1", "type": "decision_field_equals", "event_id": "m1", "field": "reason", "expected": "replied"}
  ]
}
