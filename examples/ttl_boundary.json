{
  "schema_version": 1,
  "id": "ttl_boundary",
  "description": "advance 到 TTL 边界时清理上下文，不主动发消息",
  "bot_config": {
    "bot_id": "bot",
    "cooldown_ms": 0,
    "window_ms": 60000,
    "max_messages_per_window": 10,
    "context_ttl_ms": 100
  },
  "events": [
    {
      "id": "old",
      "type": "message",
      "at_ms": 0,
      "group_id": "g1",
      "user_id": "u1",
      "text": "即将过期"
    },
    {
      "id": "before",
      "type": "advance",
      "at_ms": 99
    },
    {
      "id": "boundary",
      "type": "advance",
      "at_ms": 100
    },
    {
      "id": "ask",
      "type": "message",
      "at_ms": 100,
      "group_id": "g1",
      "user_id": "u1",
      "text": "没有旧上下文",
      "mentions": [
        "bot"
      ]
    }
  ],
  "checks": [
    {
      "id": "before_kept",
      "after_event": "before",
      "type": "context_contains",
      "group_id": "g1",
      "message_id": "old"
    },
    {
      "id": "boundary_removed",
      "after_event": "boundary",
      "type": "context_excludes",
      "group_id": "g1",
      "message_id": "old"
    },
    {
      "id": "advance_no_output",
      "after_event": "boundary",
      "type": "output_count",
      "group_id": "g1",
      "expected": 0
    },
    {
      "id": "no_context_left",
      "after_event": "ask",
      "type": "decision_field_equals",
      "event_id": "ask",
      "field": "selected_context_message_id",
      "expected": null
    }
  ]
}
