{
  "schema_version": 1,
  "id": "cooldown_blocked",
  "description": "冷却期内的 @ 被拦截，但用户输入仍保留",
  "bot_config": {
    "bot_id": "bot",
    "cooldown_ms": 10000,
    "window_ms": 60000,
    "max_messages_per_window": 10,
    "context_ttl_ms": 180000
  },
  "events": [
    {
      "id": "m1",
      "type": "message",
      "at_ms": 0,
      "group_id": "g1",
      "user_id": "u1",
      "text": "第一次",
      "mentions": [
        "bot"
      ]
    },
    {
      "id": "m2",
      "type": "message",
      "at_ms": 9999,
      "group_id": "g1",
      "user_id": "u1",
      "text": "还在冷却期",
      "mentions": [
        "bot"
      ]
    }
  ],
  "checks": [
    {
      "id": "first_sent",
      "after_event": "m1",
      "type": "output_count",
      "group_id": "g1",
      "event_id": "m1",
      "expected": 1
    },
    {
      "id": "second_not_sent",
      "after_event": "m2",
      "type": "output_count",
      "group_id": "g1",
      "event_id": "m2",
      "expected": 0
    },
    {
      "id": "cooldown",
      "after_event": "m2",
      "type": "decision_field_equals",
      "event_id": "m2",
      "field": "reason",
      "expected": "cooldown"
    },
    {
      "id": "blocked_input_stored",
      "after_event": "m2",
      "type": "context_contains",
      "group_id": "g1",
      "message_id": "m2"
    }
  ]
}
