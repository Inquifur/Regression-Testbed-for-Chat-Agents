{
  "schema_version": 1,
  "id": "cooldown_boundary",
  "description": "冷却期内拦截，达到边界后恢复",
  "bot_config": {
    "bot_id": "bot",
    "cooldown_ms": 10000,
    "window_ms": 60000,
    "max_messages_per_window": 10,
    "context_ttl_ms": 180000
  },
  "events": [
    {
      "id": "m1",
      "type": "message",
      "at_ms": 0,
      "group_id": "g1",
      "user_id": "u1",
      "text": "你好",
      "mentions": [
        "bot"
      ]
    },
    {
      "id": "m2",
      "type": "message",
      "at_ms": 9999,
      "group_id": "g1",
      "user_id": "u1",
      "text": "还在吗",
      "mentions": [
        "bot"
      ]
    },
    {
      "id": "m3",
      "type": "message",
      "at_ms": 10000,
      "group_id": "g1",
      "user_id": "u1",
      "text": "现在呢",
      "mentions": [
        "bot"
      ]
    }
  ],
  "checks": [
    {
      "id": "first_sent",
      "after_event": "m1",
      "type": "output_count",
      "group_id": "g1",
      "event_id": "m1",
      "expected": 1
    },
    {
      "id": "blocked",
      "after_event": "m2",
      "type": "decision_field_equals",
      "event_id": "m2",
      "field": "reason",
      "expected": "cooldown"
    },
    {
      "id": "boundary_sent",
      "after_event": "m3",
      "type": "output_count",
      "group_id": "g1",
      "event_id": "m3",
      "expected": 1
    }
  ]
}
