{
  "schema_version": 1,
  "id": "blocked_enters_context",
  "description": "被冷却拦截的输入仍可成为后续回复的上下文",
  "bot_config": {
    "bot_id": "bot",
    "cooldown_ms": 100,
    "window_ms": 60000,
    "max_messages_per_window": 10,
    "context_ttl_ms": 180000
  },
  "events": [
    {
      "id": "a",
      "type": "message",
      "at_ms": 0,
      "group_id": "g1",
      "user_id": "u1",
      "text": "首次 @",
      "mentions": [
        "bot"
      ]
    },
    {
      "id": "b",
      "type": "message",
      "at_ms": 1,
      "group_id": "g1",
      "user_id": "u1",
      "text": "被拦截的 @",
      "mentions": [
        "bot"
      ]
    },
    {
      "id": "c",
      "type": "message",
      "at_ms": 100,
      "group_id": "g1",
      "user_id": "u1",
      "text": "冷却后再 @",
      "mentions": [
        "bot"
      ]
    }
  ],
  "checks": [
    {
      "id": "blocked",
      "after_event": "b",
      "type": "decision_field_equals",
      "event_id": "b",
      "field": "reason",
      "expected": "cooldown"
    },
    {
      "id": "blocked_input_kept",
      "after_event": "b",
      "type": "context_contains",
      "group_id": "g1",
      "message_id": "b"
    },
    {
      "id": "latest_input_selected",
      "after_event": "c",
      "type": "decision_field_equals",
      "event_id": "c",
      "field": "selected_context_message_id",
      "expected": "b"
    },
    {
      "id": "final_sent",
      "after_event": "c",
      "type": "output_count",
      "group_id": "g1",
      "event_id": "c",
      "expected": 1
    },
    {
      "id": "two_actual_outputs",
      "after_event": "c",
      "type": "output_count",
      "group_id": "g1",
      "expected": 2
    }
  ]
}
