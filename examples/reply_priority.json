{
  "schema_version": 1,
  "id": "reply_priority",
  "description": "显式引用仍有效的旧消息优先于最近消息",
  "bot_config": {
    "bot_id": "bot",
    "cooldown_ms": 0,
    "window_ms": 60000,
    "max_messages_per_window": 10,
    "context_ttl_ms": 180000
  },
  "events": [
    {
      "id": "old",
      "type": "message",
      "at_ms": 0,
      "group_id": "g1",
      "user_id": "u1",
      "text": "较早消息"
    },
    {
      "id": "recent",
      "type": "message",
      "at_ms": 1,
      "group_id": "g1",
      "user_id": "u2",
      "text": "较新消息"
    },
    {
      "id": "ask",
      "type": "message",
      "at_ms": 2,
      "group_id": "g1",
      "user_id": "u1",
      "text": "回复旧消息",
      "mentions": [
        "bot"
      ],
      "reply_to": "old"
    }
  ],
  "checks": [
    {
      "id": "explicit_reference",
      "after_event": "ask",
      "type": "decision_field_equals",
      "event_id": "ask",
      "field": "selected_context_message_id",
      "expected": "old"
    },
    {
      "id": "reply_sent",
      "after_event": "ask",
      "type": "output_count",
      "group_id": "g1",
      "event_id": "ask",
      "expected": 1
    },
    {
      "id": "current_added_after_selection",
      "after_event": "ask",
      "type": "context_contains",
      "group_id": "g1",
      "message_id": "ask"
    }
  ]
}
