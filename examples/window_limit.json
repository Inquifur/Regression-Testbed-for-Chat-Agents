{
  "schema_version": 1,
  "id": "window_limit",
  "description": "第 N 条允许发送，已有 N 条后才拦截下一条",
  "bot_config": {
    "bot_id": "bot",
    "cooldown_ms": 0,
    "window_ms": 100,
    "max_messages_per_window": 2,
    "context_ttl_ms": 180000
  },
  "events": [
    {
      "id": "m1",
      "type": "message",
      "at_ms": 0,
      "group_id": "g1",
      "user_id": "u1",
      "text": "第一条",
      "mentions": [
        "bot"
      ]
    },
    {
      "id": "m2",
      "type": "message",
      "at_ms": 1,
      "group_id": "g1",
      "user_id": "u1",
      "text": "第二条",
      "mentions": [
        "bot"
      ]
    },
    {
      "id": "m3",
      "type": "message",
      "at_ms": 2,
      "group_id": "g1",
      "user_id": "u1",
      "text": "第三条",
      "mentions": [
        "bot"
      ]
    }
  ],
  "checks": [
    {
      "id": "first_sent",
      "after_event": "m1",
      "type": "output_count",
      "group_id": "g1",
      "event_id": "m1",
      "expected": 1
    },
    {
      "id": "nth_sent",
      "after_event": "m2",
      "type": "output_count",
      "group_id": "g1",
      "event_id": "m2",
      "expected": 1
    },
    {
      "id": "next_blocked",
      "after_event": "m3",
      "type": "output_count",
      "group_id": "g1",
      "event_id": "m3",
      "expected": 0
    },
    {
      "id": "rate_limit",
      "after_event": "m3",
      "type": "decision_field_equals",
      "event_id": "m3",
      "field": "reason",
      "expected": "rate_limit"
    }
  ]
}
